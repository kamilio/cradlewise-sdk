{
  "name": "@kamilio/cradlewise-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for the Cradlewise smart crib API",
  "keywords": [
    "cradlewise",
    "smart-crib",
    "aws-iot",
    "mqtt",
    "typescript",
    "mcp",
    "toolcraft"
  ],
  "homepage": "https://github.com/kamilio/cradlewise-sdk#readme",
  "bugs": {
    "url": "https://github.com/kamilio/cradlewise-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamilio/cradlewise-sdk.git"
  },
  "license": "MIT",
  "author": "Kamil Jopek",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toolcraft": {
      "types": "./dist/toolcraft.d.ts",
      "import": "./dist/toolcraft.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cradlewise": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:types && npm run smoke:package && npm run lint:package && npm run pack:check && npm run pack:reproducible",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "npm pack --dry-run",
    "pack:reproducible": "node scripts/reproducible-pack.mjs",
    "prepublishOnly": "npm run release:check && npm run check",
    "release:check": "node scripts/release-check.mjs",
    "smoke:types": "node scripts/declaration-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "vitest run --coverage",
    "test:integration": "node --env-file=.env --import tsx scripts/integration-test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && node scripts/attw-package.mjs"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-cognito-identity": "3.1079.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1079.0",
    "@smithy/protocol-http": "5.5.6",
    "@smithy/signature-v4": "5.6.2",
    "cognito-srp-helper": "2.3.5",
    "mqtt": "5.15.2"
  },
  "optionalDependencies": {
    "ajv": "8.20.0",
    "toolcraft": "0.0.131"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "fflate": "0.8.3",
    "prettier": "^3.6.2",
    "publint": "0.3.24",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.11"
  }
}
